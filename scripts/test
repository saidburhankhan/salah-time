#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
plugin_source="$project_dir/plugin/local.salah"

cargo fmt --all --check --manifest-path "$project_dir/Cargo.toml"
cargo test --locked --offline --workspace --manifest-path "$project_dir/Cargo.toml"
bash -n "$project_dir/scripts/install" "$project_dir/scripts/uninstall"
jq empty "$plugin_source/manifest.json" "$plugin_source/i18n/en.json"
omarchy plugin validate "$plugin_source"

test_home=$(mktemp -d)
# The scripts must never change the user's live bar while testing.
export SALAH_NO_SHELL=1
cleanup() { rm -rf -- "$test_home"; }
trap cleanup EXIT

HOME="$test_home" "$project_dir/scripts/install"
test -x "$test_home/.local/bin/salah"
test -f "$test_home/.config/omarchy/plugins/local.salah/manifest.json"
test -f "$test_home/.config/systemd/user/salah.socket"
test -f "$test_home/.config/systemd/user/salah.service"
grep -qx 'ListenStream=%t/salah/salah.sock' "$test_home/.config/systemd/user/salah.socket"
grep -qx 'SocketMode=0600' "$test_home/.config/systemd/user/salah.socket"
grep -qx "ExecStart=$test_home/.local/bin/salah serve" "$test_home/.config/systemd/user/salah.service"
if command -v qmake6 >/dev/null; then
  "$project_dir/app/bin/test" >/dev/null
  test -x "$test_home/.local/bin/salah-app"
  grep -qx "Exec=$test_home/.local/bin/salah open" "$test_home/.local/share/applications/salah.desktop"
fi
HOME="$test_home" "$test_home/.local/bin/salah" status --json \
  | jq -e '.next.name and (.next.remaining_seconds | numbers) and (.prayers | length == 6)' >/dev/null

# Reinstallation must accept an unchanged installation owned by this checkout,
# update it without the plugin directory being replaced (the running shell
# would drop a plugin that disappears), and remove files no longer shipped.
plugin_inode=$(stat -c %i "$test_home/.config/omarchy/plugins/local.salah")
: > "$test_home/.config/omarchy/plugins/local.salah/stale.qml"
HOME="$test_home" "$project_dir/scripts/install" 2>/dev/null && exit 1 # modified: refused
rm -- "$test_home/.config/omarchy/plugins/local.salah/stale.qml"
HOME="$test_home" "$project_dir/scripts/install"
test "$(stat -c %i "$test_home/.config/omarchy/plugins/local.salah")" = "$plugin_inode"
cmp -s "$plugin_source/BarWidget.qml" "$test_home/.config/omarchy/plugins/local.salah/BarWidget.qml"
HOME="$test_home" "$project_dir/scripts/uninstall"
test ! -e "$test_home/.local/bin/salah"
test ! -e "$test_home/.config/omarchy/plugins/local.salah"
test ! -e "$test_home/.local/bin/salah-app"
test ! -e "$test_home/.local/share/applications/salah.desktop"
test ! -e "$test_home/.config/systemd/user/salah.socket"
test ! -e "$test_home/.config/systemd/user/salah.service"

# Install must refuse to replace a launcher entry the user owns.
mkdir -p "$test_home/.local/share/applications"
printf '[Desktop Entry]\nName=Mine\n' > "$test_home/.local/share/applications/salah.desktop"
if command -v qmake6 >/dev/null; then
  HOME="$test_home" "$project_dir/scripts/install" 2>/dev/null && exit 1
  grep -qx 'Name=Mine' "$test_home/.local/share/applications/salah.desktop"
fi
rm -- "$test_home/.local/share/applications/salah.desktop"

# Uninstall must preserve a plugin the user changed after installation.
HOME="$test_home" "$project_dir/scripts/install"
printf '\n// local test modification\n' >> "$test_home/.config/omarchy/plugins/local.salah/BarWidget.qml"
HOME="$test_home" "$project_dir/scripts/uninstall"
test -f "$test_home/.config/omarchy/plugins/local.salah/BarWidget.qml"

printf 'All Salah tests passed.\n'
